<Project Sdk="Godot.NET.Sdk/4.3.0">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Ironwake.Godot</RootNamespace>
    <!-- The export publishes the referenced console project too, whose deps.json and runtimeconfig.json
         collide with their RID-specific copies; the client never reads either file. -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ironwake.Core\Ironwake.Core.csproj" />
    <ProjectReference Include="..\Ironwake.Content\Ironwake.Content.csproj" />
    <ProjectReference Include="..\Ironwake.Cli\Ironwake.Cli.csproj" />
    <ProjectReference Include="..\Ironwake.Client\Ironwake.Client.csproj" />
  </ItemGroup>

</Project>
